<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_folder_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp"
    android:paddingHorizontal="10dp"
    android:background="@drawable/widget_item_normal_bg_light">

    <ImageView
        android:id="@+id/widget_folder_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_folder"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/widget_folder_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Folder Name"
        android:textColor="#111115"
        android:textSize="14sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:singleLine="true" />

    <ImageView
        android:id="@+id/widget_folder_chevron"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/ic_arrow_drop_down"
        android:scaleType="fitCenter"
        android:contentDescription="Expand/Collapse" />

    <ImageView
        android:id="@+id/widget_folder_check"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_circle_unchecked"
        android:contentDescription="Check Folder" />
</LinearLayout>
